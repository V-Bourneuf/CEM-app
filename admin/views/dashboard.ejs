<%- include('_header') %>

<h2>Admin dashboard</h2>
<% if (adminUser) { %>
    <p class="muted">Signed in as <code><%= adminUser %></code>.</p>
<% } %>

<div class="card-grid">
    <div class="stat-card">
        <div class="stat-num"><%= counts.roles %></div>
        <div class="stat-label">Role entitlements</div>
    </div>
    <div class="stat-card">
        <div class="stat-num"><%= counts.access %></div>
        <div class="stat-label">Access entitlements</div>
    </div>
    <div class="stat-card">
        <div class="stat-num"><%= counts.users %></div>
        <div class="stat-label">Total provisioned users</div>
    </div>
    <div class="stat-card">
        <div class="stat-num"><%= counts.active %></div>
        <div class="stat-label">Active users</div>
    </div>
    <div class="stat-card">
        <div class="stat-num"><%= counts.grants %></div>
        <div class="stat-label">Total grants</div>
    </div>
</div>

<h3>Identity integrations</h3>
<ul class="link-list">
    <% integrations.forEach(function(i) { %>
        <li>
            <strong><%= i.key.toUpperCase() %></strong>
            <%= i.key === 'byo' ? '— BYO entitlements (SAML attrs + SCIM provisioning)' : '— Governance with SCIM 2.0' %> —
            <% if (i.configured) { %>
                <a href="/<%= i.key %>">try the demo →</a> ·
                <a href="/admin/integrations/<%= i.key %>/edit">edit config</a>
            <% } else { %>
                not configured · <a href="/admin/integrations/<%= i.key %>/edit">configure</a>
            <% } %>
        </li>
    <% }) %>
</ul>

<h3>Quick links</h3>
<ul class="link-list">
    <li><a href="/admin/integrations">Manage SAML integrations →</a></li>
    <li><a href="/admin/profiles">Manage entitlement catalog →</a></li>
    <li><a href="/admin/users">View provisioned users (across both flows) →</a></li>
    <li><a href="/byo/scim/v2/Entitlements" target="_blank">Inspect BYO SCIM Entitlements ↗</a> · <a href="/scim/scim/v2/Entitlements" target="_blank">SCIM SCIM Entitlements ↗</a> <small>(both need a bearer token)</small></li>
</ul>

<%- include('_footer') %>
