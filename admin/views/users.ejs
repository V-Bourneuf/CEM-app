<%- include('_header') %>

<h2>Provisioned users</h2>
<p class="muted">
    Users are created by Okta SCIM provisioning. Each row's <strong>Flow</strong>
    column shows which Okta app provisioned it — users from the BYO app and the SCIM app
    live in separate namespaces and can have different grants.
</p>

<% if (flash) { %><div class="flash success"><%= flash %></div><% } %>
<% if (error) { %><div class="flash error">⚠️ <%= error %></div><% } %>

<% if (users.length === 0) { %>
    <div class="empty-state">
        No users yet. Configure SCIM provisioning in Okta and assign a user to one of the apps.
        <br><small>SCIM Base URLs:
        <% flows.forEach(function(f, i) { %>
            <code>/<%= f %>/scim/v2</code><%= i < flows.length - 1 ? ' · ' : '' %>
        <% }) %>
        </small>
    </div>
<% } else { %>
<table class="data-table">
    <thead>
        <tr>
            <th>Flow</th>
            <th>Username</th>
            <th>Name</th>
            <th>Email</th>
            <th>Status</th>
            <th>Grants</th>
            <th>Last updated</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    <% users.forEach(function(u) { %>
        <tr>
            <td><span class="badge type-<%= u.flow === 'byo' ? 'role' : 'access' %>"><%= (u.flow || '').toUpperCase() %></span></td>
            <td><code><%= u.user_name %></code></td>
            <td><%= [u.given_name, u.family_name].filter(Boolean).join(' ') || '—' %></td>
            <td><%= u.email || '—' %></td>
            <td><span class="badge <%= u.active ? 'status-active' : 'status-inactive' %>"><%= u.active ? 'active' : 'inactive' %></span></td>
            <td>
                <% if (u.grants.length === 0) { %>
                    <span class="muted">—</span>
                <% } else { %>
                    <% u.grants.forEach(function(g) { %>
                        <span class="badge type-<%= g.type %>" title="<%= g.value %>"><%= g.display_name %></span>
                    <% }) %>
                <% } %>
            </td>
            <td class="muted"><%= u.updated_at %></td>
            <td class="actions">
                <form method="post" action="/admin/users/<%= u.id %>/delete"
                      onsubmit="return confirm('Delete &quot;<%= u.user_name %>&quot; (<%= u.flow %>) from the local DB?\n\nThis removes the user row and all grants. Okta still has them assigned and may re-provision on the next sync — to remove fully, also unassign in Okta admin.');"
                      style="margin:0;display:inline">
                    <button type="submit" class="btn-link btn-link--danger" title="Delete this user from the local DB">Delete</button>
                </form>
            </td>
        </tr>
    <% }) %>
    </tbody>
</table>
<% } %>

<%- include('_footer') %>
