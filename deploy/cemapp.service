[Unit]
Description=CEM App — Okta IGA reference (SAML SSO + SCIM 2.0)
After=network.target

[Service]
Type=simple
User=cemapp
Group=cemapp
WorkingDirectory=/opt/cemapp
EnvironmentFile=/opt/cemapp/.env.production
ExecStart=/usr/bin/node server.js --profile production
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/cemapp/data /opt/cemapp/profiles /opt/cemapp/saml-debug.log
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Resource limits
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
