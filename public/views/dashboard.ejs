<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>CEM App — Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <header class="app-header">
        <div class="brand">
            <span class="brand-mark">CEM</span>
            <span>CEM App</span>
        </div>
        <div class="user-info">
            <span class="user-name"><%= [user.firstName, user.lastName].filter(Boolean).join(' ') || user.email %></span>
            <span class="user-email"><%= user.email %></span>
            <% if (isAdmin) { %>
                <a href="/admin/dashboard" class="admin-tab">Admin →</a>
            <% } %>
            <a href="/logout" class="logout-link">Sign out</a>
        </div>
    </header>

    <main class="dashboard">

        <!-- ─────────────────────  SAML assertion  ────────────────────── -->
        <section class="card assertion-card">
            <h2>SAML assertion</h2>
            <p class="card-subtitle">Attributes received from Okta in this session.</p>

            <dl class="kv-list">
                <dt>NameID</dt>
                <dd><code><%= samlAssertion.nameID || '—' %></code></dd>

                <dt>NameID format</dt>
                <dd><code><%= samlAssertion.nameIDFormat || '—' %></code></dd>

                <dt>Issuer</dt>
                <dd><code><%= samlAssertion.issuer || '—' %></code></dd>

                <dt>Session index</dt>
                <dd><code><%= samlAssertion.sessionIndex || '—' %></code></dd>

                <% Object.entries(samlAssertion.attributes || {}).forEach(([key, value]) => { %>
                    <dt><%= key %></dt>
                    <dd>
                        <% if (Array.isArray(value)) { %>
                            <% if (value.length === 0) { %>
                                <span class="pill" style="background:#f3f4f6;color:#9ca3af;border-color:#e5e7eb">(empty)</span>
                            <% } else { %>
                                <% value.forEach(v => { %>
                                    <span class="pill"><%= v %></span>
                                <% }) %>
                            <% } %>
                        <% } else if (value === null || value === undefined || value === '') { %>
                            <span class="pill" style="background:#f3f4f6;color:#9ca3af;border-color:#e5e7eb">(empty)</span>
                        <% } else { %>
                            <code><%= value %></code>
                        <% } %>
                    </dd>
                <% }) %>
            </dl>
        </section>

        <!-- ───────────────────────  Roles  ─────────────────────────── -->
        <section class="card roles-card">
            <h2>Roles</h2>
            <p class="card-subtitle">
                All roles defined in the CEM App catalog.
                <span class="granted-marker">●</span> = granted to you.
            </p>

            <ul class="entitlement-list">
                <% roleCatalog.forEach(role => {
                    const granted = (entitlements.role || []).includes(role.value);
                %>
                    <li class="entitlement-item <%= granted ? 'granted' : '' %>">
                        <span class="entitlement-icon"><%- granted ? '●' : '○' %></span>
                        <span class="entitlement-name"><%= role.displayName %></span>
                        <span></span>
                        <code class="entitlement-value"><%= role.value %></code>
                    </li>
                <% }) %>
            </ul>
        </section>

        <!-- ─────────────────  Access permissions  ──────────────────── -->
        <section class="card access-card">
            <h2>Access permissions</h2>
            <p class="card-subtitle">
                All access permissions defined in the CEM App catalog.
                <span class="granted-marker">●</span> = granted to you.
            </p>

            <ul class="entitlement-list">
                <% accessCatalog.forEach(access => {
                    const granted = (entitlements.access || []).includes(access.value);
                %>
                    <li class="entitlement-item <%= granted ? 'granted' : '' %>">
                        <span class="entitlement-icon"><%- granted ? '●' : '○' %></span>
                        <span class="entitlement-name"><%= access.displayName %></span>
                        <span class="entitlement-column"><%= access.column || '' %></span>
                        <code class="entitlement-value"><%= access.value %></code>
                    </li>
                <% }) %>
            </ul>
        </section>

        <!-- ──────────────────  Provenance footer  ─────────────────── -->
        <p class="provenance-note <%= provisionedFromDb ? 'from-scim' : 'from-saml' %>">
            <% if (provisionedFromDb) { %>
                ✓ Grants resolved from SCIM-provisioned database record
            <% } else { %>
                ⚡ Grants resolved from SAML attributes (user not yet provisioned via SCIM)
            <% } %>
        </p>
    </main>
</body>
</html>
